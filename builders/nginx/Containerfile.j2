{%- set remove_rpms_from_newroot = 'grep findutils bash coreutils-single' -%}

{{ setup_newroot() }}
{{ install_newroot() }}
{{ cleanup_newroot() }}

# Make sure the nginx logs appear on STDOUT and STDERR
RUN ln -sf /dev/stdout ${NEWROOT}/var/log/nginx/access.log && \
    ln -sf /dev/stderr ${NEWROOT}/var/log/nginx/error.log

COPY rootfs/nginx/nginx.conf ${NEWROOT}/etc/nginx/nginx.conf
COPY rootfs/nginx/conf.d/default.conf ${NEWROOT}/etc/nginx/conf.d/default.conf
COPY rootfs/nginx/html/index.html ${NEWROOT}/usr/share/nginx/html/index.html

{{ final_stage() }}

ENV APP_NAME="nginx" \
    APP_VERSION="{{ package_version("nginx-core") }}" \
    NGINX_VERSION={{ package_version("nginx-core") }}

EXPOSE 8080
STOPSIGNAL SIGQUIT

ENTRYPOINT ["/usr/sbin/nginx"]
CMD ["-c", "/etc/nginx/nginx.conf", "-e", "/dev/stderr", "-g", "daemon off;"]
{{ set_user() }}

# nginx + third-party dynamic modules, runtime seeded from the FIPS image.
#
# gcc/make/git stay in the hummingbird *builder* filesystem only
# (--installroot=/). They must never land in ${NEWROOT} (chunkah would
# publish them as rpm/gcc layers and balloon the image past the ~18MiB
# FIPS runtime).
#
#   --build-arg NGINX_FIPS_RUNTIME=registry.access.redhat.com/hi/nginx:latest-fips

ARG NGINX_FIPS_RUNTIME=registry.access.redhat.com/hi/nginx:latest-fips
FROM ${NGINX_FIPS_RUNTIME} AS nginx-fips-runtime

{{ setup_newroot() }}

# Use the FIPS runtime as NEWROOT instead of dnf-installing a blank chroot.
# Do not call install_newroot() — that re-resolves nginx-core and pulls
# weak deps (gperftools, systemd, gcc-adjacent libs) into the image.
COPY --from=nginx-fips-runtime / ${NEWROOT}/

# Toolchain in the *builder* root only. Hummingbird dnf.conf may default
# installroot to NEWROOT; override it so gcc never enters the runtime.
RUN set -eux; \
    if command -v dnf >/dev/null 2>&1; then PKGMGR=dnf; \
    elif command -v microdnf >/dev/null 2>&1; then PKGMGR=microdnf; \
    else PKGMGR=yum; fi; \
    $PKGMGR -y --installroot=/ --setopt=install_weak_deps=0 --skip-unavailable \
        install gcc gcc-c++ make git \
        pcre2-devel zlib-devel openssl-devel \
        tar gzip curl; \
    $PKGMGR --installroot=/ clean all || true

WORKDIR /usr/src

RUN set -eux; \
    NGINX_VER="$(echo '{{ package_version("nginx-core") }}' | sed 's/-.*//')"; \
    test -n "$NGINX_VER"; \
    echo "$NGINX_VER" > /usr/src/nginx.version; \
    curl -fsSL "https://nginx.org/download/nginx-${NGINX_VER}.tar.gz" -o nginx.tar.gz; \
    tar -xzf nginx.tar.gz; \
    ln -s "nginx-${NGINX_VER}" nginx-src; \
    git clone --depth 1 https://github.com/openresty/headers-more-nginx-module.git; \
    git clone --depth 1 https://github.com/vision5/ngx_devel_kit.git ngx_devel_kit; \
    git clone --depth 1 https://github.com/openresty/set-misc-nginx-module.git

WORKDIR /usr/src/nginx-src
RUN set -eux; \
    ./configure --with-compat --with-http_ssl_module \
        --add-dynamic-module=/usr/src/headers-more-nginx-module \
        --add-dynamic-module=/usr/src/ngx_devel_kit \
        --add-dynamic-module=/usr/src/set-misc-nginx-module; \
    make -j"$(nproc)" modules; \
    mkdir -p ${NEWROOT}/usr/share/nginx/modules; \
    cp -a objs/*.so ${NEWROOT}/usr/share/nginx/modules/; \
    printf '%s\n' \
        'load_module /usr/share/nginx/modules/ngx_http_headers_more_filter_module.so;' \
        'load_module /usr/share/nginx/modules/ndk_http_module.so;' \
        'load_module /usr/share/nginx/modules/ngx_http_set_misc_module.so;' \
        > ${NEWROOT}/usr/share/nginx/modules/90-third-party.conf; \
    rm -rf /usr/src /root/.cache; \
    ls -l ${NEWROOT}/usr/share/nginx/modules

# If any build RPM leaked into NEWROOT, drop it. gcc is not a runtime dep.
# gperftools is only needed if the FIPS nginx binary is linked to tcmalloc;
# it already lives in the 18MiB base when required — do not add it here.
RUN set -eux; \
    if command -v dnf >/dev/null 2>&1; then \
        dnf -y --installroot="${NEWROOT}" --setopt=install_weak_deps=0 \
            remove gcc gcc-c++ make git \
            pcre2-devel zlib-devel openssl-devel \
            redhat-rpm-config 2>/dev/null || true; \
        dnf --installroot="${NEWROOT}" clean all || true; \
    fi; \
    rm -rf "${NEWROOT}/var/cache/dnf" "${NEWROOT}/var/cache/yum" \
           "${NEWROOT}/usr/src" "${NEWROOT}/root/.cache"

{{ cleanup_newroot() }}

# Make sure the nginx logs appear on STDOUT and STDERR
RUN ln -sf /dev/stdout ${NEWROOT}/var/log/nginx/access.log && \
    ln -sf /dev/stderr ${NEWROOT}/var/log/nginx/error.log

COPY prebuildfs/ ${NEWROOT}/
COPY rootfs/entrypoint.sh ${NEWROOT}/entrypoint.sh
COPY rootfs/scripts/ ${NEWROOT}/usr/local/bin/
COPY rootfs/docker-entrypoint-initdb.d/ ${NEWROOT}/usr/local/docker-entrypoint-initdb.d/
COPY rootfs/nginx/ ${NEWROOT}/etc/nginx/
COPY rootfs/nginx/html/index.html ${NEWROOT}/usr/share/nginx/html/index.html

RUN chown -R {{ default_user }}:0 ${NEWROOT}/usr/local/bin && \
    chown -R {{ default_user }}:0 ${NEWROOT}/usr/local/docker-entrypoint-initdb.d && \
    chmod -R g=u ${NEWROOT}/usr/local/bin && \
    chmod -R g=u ${NEWROOT}/usr/local/docker-entrypoint-initdb.d

RUN touch ${NEWROOT}/usr/share/nginx/modules/placeholder.conf && \
    chmod 644 ${NEWROOT}/usr/share/nginx/modules/*.so ${NEWROOT}/usr/share/nginx/modules/*.conf || true

{{ final_stage() }}

ENV APP_NAME="nginx" \
    APP_VERSION="{{ package_version("nginx-core") }}" \
    NGINX_VERSION={{ package_version("nginx-core") }} \
    ENABLE_MODULES="headers-more ndk set-misc" \
    PATH="/usr/local/bin/nginx:$PATH" \
    INITSCRIPTS_DIR="/usr/local/docker-entrypoint-initdb.d"

EXPOSE 8080
STOPSIGNAL SIGQUIT

ENTRYPOINT ["/entrypoint.sh"]
CMD ["run.sh"]
{{ set_user() }}

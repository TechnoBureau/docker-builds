{{ setup_newroot() }}
{{ install_newroot() }}
{{ cleanup_newroot() }}

# Build the static binary with the hummingbird toolchain. The build happens
# outside NEWROOT, so the build dependencies and sources never reach the
# final image (chunkah snapshots only NEWROOT).
RUN dnf -y install --setopt=install_weak_deps=False gcc glibc-static

COPY src/ /tmp/snooze-src/
RUN mkdir -p /tmp/snooze-build && \
    gcc -Os -static -s -o /tmp/snooze-build/snooze /tmp/snooze-src/snooze.c

RUN cp /tmp/snooze-build/snooze ${NEWROOT}/snooze

{{ final_stage() }}

EXPOSE 8080

ENTRYPOINT ["/snooze"]
{{ set_user() }}

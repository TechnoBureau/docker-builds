FROM quay.io/hummingbird-ci/hummingbird-builder:latest AS build
RUN dnf -y install gcc glibc-static
COPY src/ /app/
RUN gcc -Os -static -s -o /app/snooze /app/snooze.c

# hi/static: Red Hat's minimal base for statically compiled applications —
# CA certificates, timezone data, non-root user; no shell, libc, or package
# manager (https://hummingbird-project.io, images/static).
FROM registry.access.redhat.com/hi/static:latest
COPY --from=build /app/snooze /snooze

ENV HOME=/tmp
WORKDIR /tmp

EXPOSE 8080

ENTRYPOINT ["/snooze"]
USER 65532
